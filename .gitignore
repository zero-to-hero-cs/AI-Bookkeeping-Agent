# ---- 运行时生成的数据（每个人的账本不一样，不能进仓库）----
data/*
!data/.gitkeep

# ---- 编译产物 ----
*.exe
*.o
*.obj
*.pdb

# ---- 程序生成的图片（只忽略这一张；assets 里的文档截图要提交）----
/消费分类饼图.png

# ---- 密钥！绝对不能提交 ----
.env
.env.*
config.json
config.txt

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 临时目录 ----
.tmp/

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

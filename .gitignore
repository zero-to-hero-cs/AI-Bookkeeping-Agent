# ---- 运行时生成的数据（每个人的账本不一样，不能进仓库）----
data/*
!data/.gitkeep

# ---- 临时目录（装依赖失败时可能残留，手动删掉即可）----
.tmp/

# ---- 编译产物 ----
*.exe
*.o

# ---- 程序生成的图片 ----
消费分类饼图.png
*.png

# ---- 密钥！绝对不能提交 ----
.env
.env.*
config.json
config.txt

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
